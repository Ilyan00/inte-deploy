{
  "name": "api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:start": "supabase start --workdir .. -x studio,imgproxy,mailpit,vector,logflare,supavisor,edge-runtime,realtime,storage-api",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir .."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supabase": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
