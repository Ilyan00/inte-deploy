SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxx
# Connexion Postgres directe, utilisée uniquement par le runner de migrations (pnpm db:migrate).
# Local : postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud : URL du "Session pooler" (dashboard > Connect), la connexion directe est IPv6 uniquement.
DATABASE_URL=postgresql://postgres.xxxx:[MOT_DE_PASSE]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
