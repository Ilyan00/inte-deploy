{
  "name": "inte-deploy",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently -k -n front,api -c blue,green \"nuxt dev\" \"pnpm --filter api dev\"",
    "dev:front": "nuxt dev",
    "dev:api": "pnpm --filter api dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/i18n": "^10.6.0",
    "eslint": "^10.14.0",
    "nuxt": "^4.6.3",
    "prettier": "^3.9.10",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "ofetch": "1.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
